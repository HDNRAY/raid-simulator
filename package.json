{
  "name": "raid-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Single-boss realtime combat simulator. Canvas/PixiJS renderer over a zero-dependency deterministic core.",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:core": "vitest run --project core",
    "verify:e2e": "node tools/verify-e2e.mjs"
  },
  "dependencies": {
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
